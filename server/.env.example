# ── Database ──────────────────────────
DATABASE_URL=sqlite:///./studydash.db

# ── Vector Store ──────────────────────
CHROMA_PERSIST_DIR=./chroma

# ── AI APIs ───────────────────────────
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
HF_TOKEN=hf_your_token_here
HF_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# ── Chunking ──────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# ── Retrieval ─────────────────────────
TOP_K=5

# ── File Storage ──────────────────────
UPLOAD_DIR=./uploads

# ── OCR ───────────────────────────────
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_MIN_TEXT_LENGTH=50
